PORT=5000

# MongoDB
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority&appName=<app-name>"
MONGODB_DB_NAME="test"
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority&appName=<app-name>"

# Auth secrets
SECRET_KEY="replace-with-access-token-secret"
REFRESH="replace-with-refresh-token-secret"
JWT_VERIFY="replace-with-email-verification-secret"

# Server and CORS
SERVER_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DOCKER_SERVER_BASE_URL=http://localhost:3000
DOCKER_ALLOWED_ORIGINS=http://localhost:3000

# Email credentials
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Gmail OAuth credentials
GMAIL_CLIENT_ID="your-gmail-oauth-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-gmail-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-gmail-refresh-token"
GMAIL_SENDER="your-email@gmail.com"

# Google sign-in
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Resend email
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="hello@yourdomain.com"
RESEND_FROM_NAME="FitTrack App"

# Frontend
VITE_API_URL="/api"

# Tests and E2E
TEST_MONGODB_URI=
E2E_BACKEND_PORT=5001
E2E_FRONTEND_PORT=4173
