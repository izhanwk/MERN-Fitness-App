# Copy this to .env.docker or export these variables before running Docker Compose.
# docker-compose.yml reads MONGODB_* for Atlas and DOCKER_* for container URLs.

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fittrack
DOCKER_SERVER_BASE_URL=http://localhost:5000
DOCKER_ALLOWED_ORIGINS=http://localhost:3000
DOCKER_VITE_API_URL=http://localhost:5000

SECRET_KEY=replace_with_access_token_secret
REFRESH=replace_with_refresh_token_secret
JWT_VERIFY=replace_with_email_verification_secret

GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_FROM_NAME=FitTrack App
