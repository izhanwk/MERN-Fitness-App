{
  "name": "new-fitness-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "eslint .",
    "test": "vitest",
    "test:frontend": "npm --prefix frontend run test:run",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "playwright test",
    "test:run": "vitest run",
    "migrate:users": "npm --prefix backend run migrate:users",
    "preview": "npm --prefix frontend run preview",
    "start": "npm --prefix backend run start",
    "start:server": "npm --prefix backend run start"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^27.0.1",
    "vitest": "^3.2.4"
  }
}
